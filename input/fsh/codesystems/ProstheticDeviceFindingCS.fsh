CodeSystem: ProstheticDeviceFindingCS
Id: prosthetic-device-finding
Title: "Prosthetic Device Finding"
Description: "Manufacturer-neutral technical findings concerning removable dental prostheses and implant suprastructures."
* ^url = "https://fhir.cognovis.de/dental/CodeSystem/prosthetic-device-finding"
* ^status = #active
* ^experimental = false
* ^caseSensitive = true
* ^content = #complete
* ^publisher = "cognovis GmbH"

* #base-fracture "Prosthesis base fracture" "Fracture of a removable prosthesis base."
* #clasp-fracture "Clasp fracture" "Fracture of a clasp on a removable prosthesis."
* #prosthetic-tooth-loss "Loss of prosthetic tooth" "Loss of a tooth from a removable prosthesis."
* #prosthetic-tooth-fracture "Fracture of prosthetic tooth" "Fracture of a tooth on a removable prosthesis."
* #extension-required "Prosthesis extension required" "The removable prosthesis requires extension."
* #clasp-adjustment-required "Clasp adjustment required" "A clasp on the removable prosthesis requires adjustment."
* #localized-fit-loss "Localized loss of fit" "The removable prosthesis has a localized loss of fit."
* #generalized-fit-loss "Generalized loss of fit" "The removable prosthesis has a generalized loss of fit."
* #screw-loosening "Screw loosening" "A screw in the implant suprastructure is loose."
* #screw-fracture "Screw fracture" "A screw in the implant suprastructure is fractured."
* #abutment-loosening "Abutment loosening" "An abutment supporting the suprastructure is loose."
* #abutment-fracture "Abutment fracture" "An abutment supporting the suprastructure is fractured."
* #crown-decementation "Crown decementation" "A crown belonging to the suprastructure has lost retention."
* #veneering-fracture "Veneering fracture" "The veneering material of the suprastructure is fractured."
* #crown-fracture "Crown fracture" "A crown belonging to the suprastructure is fractured."
* #framework-fracture "Framework fracture" "The framework of the suprastructure is fractured."
* #attachment-retention-loss "Attachment retention loss" "An attachment has lost retention."
* #attachment-wear "Attachment wear" "An attachment is worn."
* #matrix-wear "Matrix wear" "The matrix component of an attachment is worn."
