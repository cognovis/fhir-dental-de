### Validate entered-in-error without clinicalStatus
# Expected: successful validation
POST http://localhost:8080/fhir/Condition/$validate?profile=https://fhir.cognovis.de/dental/StructureDefinition/dental-condition
Authorization: Basic basic:secret
Content-Type: application/fhir+json

{
  "resourceType": "Condition",
  "meta": {
    "profile": [
      "https://fhir.cognovis.de/dental/StructureDefinition/dental-condition"
    ]
  },
  "verificationStatus": {
    "coding": [
      {
        "system": "http://terminology.hl7.org/CodeSystem/condition-ver-status",
        "code": "entered-in-error"
      }
    ]
  },
  "category": [
    {
      "coding": [
        {
          "system": "https://fhir.cognovis.de/dental/CodeSystem/dental-category",
          "code": "dental"
        }
      ]
    }
  ],
  "code": {
    "coding": [
      {
        "system": "http://fhir.de/CodeSystem/bfarm/icd-10-gm",
        "code": "K02.1"
      }
    ]
  },
  "subject": {
    "reference": "Patient/pat-gkv-01"
  }
}

