### ValueSet: ToothIdentificationFDI_VS - Reject Quadrant Pseudo-Tooth (5)
# System: https://fhir.cognovis.de/dental/CodeSystem/tooth-identification-fdi
# Expected: result=false
GET http://localhost:8080/ValueSet/$validate-code?url=https://fhir.cognovis.de/dental/ValueSet/tooth-identification-fdi&system=https://fhir.cognovis.de/dental/CodeSystem/tooth-identification-fdi&code=5
Authorization: Basic basic:secret

> {%
  client.test("ValueSet rejects quadrant 5", function () {
    const result = response.body.parameter?.find((item) => item.name === "result");
    client.assert(result?.valueBoolean === false, "Expected quadrant 5 to be rejected");
  });
%}

### ValueSet: ToothIdentificationFDI_VS - Validate Invalid Code
# System: https://fhir.cognovis.de/dental/CodeSystem/tooth-identification-fdi
# Expected: result=false
GET http://localhost:8080/ValueSet/$validate-code?url=https://fhir.cognovis.de/dental/ValueSet/tooth-identification-fdi&system=https://fhir.cognovis.de/dental/CodeSystem/tooth-identification-fdi&code=INVALID_XYZ
Authorization: Basic basic:secret

> {%
  client.test("ValueSet rejects an unknown tooth code", function () {
    const result = response.body.parameter?.find((item) => item.name === "result");
    client.assert(result?.valueBoolean === false, "Expected an unknown code to be rejected");
  });
%}
