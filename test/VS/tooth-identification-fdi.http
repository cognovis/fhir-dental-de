### ValueSet: ToothIdentificationFDI_VS - Expand
# VS URL: https://fhir.cognovis.de/dental/ValueSet/tooth-identification-fdi
# Expected: exactly 52 permanent and deciduous tooth positions
GET http://localhost:8080/ValueSet/tooth-identification-fdi/$expand
Authorization: Basic basic:secret

> {%
  client.test("Expansion contains exactly 52 tooth positions", function () {
    const expansion = response.body.expansion;
    const total = expansion?.total ?? expansion?.contains?.length;
    client.assert(total === 52, `Expected 52 tooth positions, received ${total}`);
  });
%}

### ValueSet: ToothIdentificationFDI_VS - Validate Valid Code (36)
# System: https://fhir.cognovis.de/dental/CodeSystem/tooth-identification-fdi
# Expected: result=true
GET http://localhost:8080/ValueSet/$validate-code?url=https://fhir.cognovis.de/dental/ValueSet/tooth-identification-fdi&system=https://fhir.cognovis.de/dental/CodeSystem/tooth-identification-fdi&code=36
Authorization: Basic basic:secret

> {%
  client.test("ValueSet supports permanent tooth 36", function () {
    const result = response.body.parameter?.find((item) => item.name === "result");
    client.assert(result?.valueBoolean === true, "Expected tooth 36 to validate");
  });
%}

