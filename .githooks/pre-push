#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
management="${FHIR_MANAGEMENT_ROOT:-$root/../fhir-management}"
zero_sha="0000000000000000000000000000000000000000"
if [[ ! -f "$management/pyproject.toml" ]]; then
  echo "[pre-push] WARNING: fhir-management unavailable; newest-parent check deferred to CI." >&2
  exit 0
fi

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ -n "${local_sha:-}" ]] || continue
  [[ "$local_sha" == "$zero_sha" ]] && continue
  if [[ "$local_sha" != "$(git rev-parse HEAD)" ]]; then
    echo "[pre-push] WARNING: pushed ref is not checked out; newest-parent check deferred to CI." >&2
    continue
  fi
  base="$remote_sha"
  if [[ "$base" == "$zero_sha" ]]; then
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
  fi
  if [[ -z "$base" ]]; then
    echo "[pre-push] WARNING: cannot determine pushed commit range; newest-parent check deferred to CI." >&2
    continue
  fi
  uv run --project "$management" fhir-graph \
    --repos "$management/configs/repos.yaml" \
    check-published-parents \
    --repo fhir-dental-de \
    --repo-path "$root" \
    --base "$base" \
    --head "$local_sha" \
    --mode local \
    --timeout 8
done
